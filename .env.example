# ==========================================
# Edge AI Vision System Configuration
# ==========================================

# Server Settings
APP_NAME="Edge AI YOLO Vision Engine"
APP_ENV="development"
HOST="0.0.0.0"
PORT=8000
DEBUG=false
CORS_ORIGINS="*"

# Camera / Stream Source
# Use integer (e.g. 0) for webcam, URL for RTSP/HTTP, or path to .mp4 video file
CAMERA_SOURCE="0"
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30
ENABLE_MOCK_FALLBACK=true

# Model & Inference Settings
# Supported formats: .pt (PyTorch Ultralytics) or .onnx (ONNX Runtime)
MODEL_PATH="yolov8n.pt"
INFERENCE_BACKEND="ultralytics" # Options: "ultralytics" or "onnxruntime"
IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45
HALF_PRECISION=false
DEVICE="auto" # Options: "auto", "cpu", "cuda", "0"

# WebSocket & Streaming Settings
WS_JPEG_QUALITY=75
WS_MAX_CLIENTS=10
WS_TARGET_FPS=30
